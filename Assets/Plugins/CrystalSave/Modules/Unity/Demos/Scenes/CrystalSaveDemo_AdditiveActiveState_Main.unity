    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<b>Heads-up \u2014 Additive scenes & the active-scene caveat</b>\nThis
    demo calls <b>SceneManager.SetActiveScene(area)</b> after the additive load so
    Crystal Save's <b>RememberHomeScene</b> snapshot/restore pipeline fires for the
    area scene (otherwise design-time-disabled GameObjects like <i>CubeB_StartsDisabled</i>
    would not be re-enabled).\n<b>Side effect:</b> while the area is the active scene,
    <b>Object.Instantiate(prefab)</b> calls without an explicit parent or destination
    scene land in the area scene and are destroyed when it unloads.\n<b>Recommended:</b>
    use <b>SaveablePrefabFactory.Instantiate(..., sceneName)</b>, pass a parent that
    lives in the desired scene, or call <b>SceneManager.MoveGameObjectToScene(go,
    mainScene)</b> right after Instantiate. See <i>\u201CAdditive scenes and the
    active-scene caveat\u201D</i> in the online docs.\n\n<b>Clicking on Enter Area
    auto-loads the last saved state in this demo</b>"
