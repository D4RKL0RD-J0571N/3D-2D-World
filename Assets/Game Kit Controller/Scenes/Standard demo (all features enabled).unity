  m_GameObject: {fileID: 1374616052}
  m_Text: "This is a laser, when you touch it, \nyou can aim to reflect a laser from
    \n your hand. It can be used to\n activate devices  or as a weapon \n against
    enemies.  Careful, \nunlike those, enemies lasers\n hurt you. This laser make
    \nyours reflect 2 times"
