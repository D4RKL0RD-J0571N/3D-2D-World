  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 684213789}
  m_Text: "This turret is your ally. It will shoot to any close \nenemy. You can carry
    with you and drop it in\n the normal mode, or grab and throw it in the aim mode.
    \nIn the aim mode you can set the turret in any surface \nby pressing Left mouse
    button.\n\n Every turret can switch between \nlaser, machine gun or cannon."
