  mainScrollRect: {fileID: 335655656}
  sceneInfoList:
  - Name: Armor Cloth System
    sceneDescription: A demo to show the different armor cloth elements and examples
      on the AI as well.
    sceneNumber: 1
    sceneImage: {fileID: 2800000, guid: a1f20fbcb58156d4d919bd9c70aa367d, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: 2.5d Extended Demo
    sceneDescription: A 2.5d demo with most elements on it for AI, vehicles, interaction,
      traversal movements, and more.
    sceneNumber: 2
    sceneImage: {fileID: 2800000, guid: 651d9464b253735459c8cad22be99ae4, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: 2.5d Demo
    sceneDescription: A 2.5d demo with different orientations.
    sceneNumber: 3
    sceneImage: {fileID: 2800000, guid: a2c20e687de65a442a02f63e14561aa2, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: 2.5d 8 Way Aim Direction
    sceneDescription: A 2.5d demo with 2 players, one of them controlled by keyboard
      and the other with gamepad, with a clamp to use 8 aim directions.
    sceneNumber: 4
    sceneImage: {fileID: 2800000, guid: a2c20e687de65a442a02f63e14561aa2, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Ability System
    sceneDescription: A demo to show the new ability system, which allows to add
      new abilities to the player easily, even combining it with the action system,
      to add actions like spell casting, throw objects, take pickups from the ground,
      use a grappling hook, etc..
    sceneNumber: 5
    sceneImage: {fileID: 2800000, guid: d8e4756dda365d14ea305e51b6671a55, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 15
    titleFontSize: 0
  - Name: Action System
    sceneDescription: A demo to show the new action which allows to add new actions
      to the player based on animations very easily, to make things like roll, vault,
      take pickups, open doors, sit on chair, walk on cliff, stealth kill, etc...
    sceneNumber: 6
    sceneImage: {fileID: 2800000, guid: dfc97c64838a2f04e912a8be836aa708, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 15
    titleFontSize: 0
  - Name: AI Basic
    sceneDescription: A demo showing the basics of the AI for both friend and enemy.
    sceneNumber: 7
    sceneImage: {fileID: 2800000, guid: 6034abfc869ad5a46959758579c24744, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: AI Extended
    sceneDescription: A short demo showing other AI elements, such as friend AI which
      can get on and off from vehicles and free and fixed hide position places for
      enemies.
    sceneNumber: 8
    sceneImage: {fileID: 2800000, guid: b78e226371f3f15498ce6dc1d5aa56f8, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Climb System
    sceneDescription: A short demo to try the free climb and ledge system, with surfaces
      with different configuration, such as not being able to grab a ledge or climb
      it.
    sceneNumber: 9
    sceneImage: {fileID: 2800000, guid: 4a911a5558b2dc5479d4c6bcceb99279, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Crafting System
    sceneDescription: A demo to show the elements of the new crafting system, including
      workbenches, object creation, blueprints, materials and more.
    sceneNumber: 10
    sceneImage: {fileID: 2800000, guid: 8e3d81bac14bfc749a14193a346de239, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Cutscene System
    sceneDescription: A short demo to show the cutscene system to pause player actions
      and move the camera through a group of waypoints/spline.
    sceneNumber: 11
    sceneImage: {fileID: 2800000, guid: 3d32e3164cc52c84db9ff56732601710, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Dialog System
    sceneDescription: A short demo showing the dialog system in two different NPCs,
      which can trigger different events.
    sceneNumber: 12
    sceneImage: {fileID: 2800000, guid: 417f68d05430be2468b43226d2d92369, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Dual Wield Weapons System
    sceneDescription: A short demo showing the new dual weapon system, to configure
      separated weapons for each hand, similar to games like wolfenstein.
    sceneNumber: 13
    sceneImage: {fileID: 2800000, guid: b7c0faf2e723b7d40b7862493311072c, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Elevators and Doors System
    sceneDescription: A short demo showing different types of doors and elevators.
    sceneNumber: 14
    sceneImage: {fileID: 2800000, guid: a65f86383c3defe47a5345ba28b68345, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Experience, Skills, Stats, Level EXP
    sceneDescription: A short demo showing all the new RPG elements, including XP
      and levels, skills with upgrades, currencey, vendor system and more, all with
      serialization.
    sceneNumber: 15
    sceneImage: {fileID: 2800000, guid: 348b610a7cea4dd45b09bbf09febee27, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Generic Models and Ride System
    sceneDescription: A short demo showing all the examples configured as generic
      models, allowing to shape shifting in real time and ride animals and other
      elements.
    sceneNumber: 16
    sceneImage: {fileID: 2800000, guid: 7afe38d8d520caa47ad28975792ff643, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: GKC Showcase Demo 1
    sceneDescription: A demo to include different elements of the most important
      systems of the asset.
    sceneNumber: 17
    sceneImage: {fileID: 2800000, guid: e5bda78894249fa4797a91629c1407ce, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: GKC Showcase Demo 2
    sceneDescription: A 2nd demo to include different elements of the most important
      systems of the asset.
    sceneNumber: 18
    sceneImage: {fileID: 2800000, guid: fb1c67d41b521c544b7ce46361fb10d5, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Grab Objects System
    sceneDescription: A demo to show some features related to grab objects system,
      to carry objects on player's hands, with powers and more.
    sceneNumber: 19
    sceneImage: {fileID: 2800000, guid: 6667680d728a2b64188c351349478040, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Gravity Room Manipulation
    sceneDescription: A demo to show some features related to the room gravity system
      to configure multiple gravity zones in the same level.
    sceneNumber: 20
    sceneImage: {fileID: 2800000, guid: e1040b9807fc60245952930388133570, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Inventory System
    sceneDescription: A demo to show the different elements of the inventory, including
      consumables, inventory weight, inventory bank, etc...
    sceneNumber: 21
    sceneImage: {fileID: 2800000, guid: f432797050f2b724ba36abe32faa90e8, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Lock On Targets
    sceneDescription: A short demo to try the lock on system on different objects
      and character/NPC/enemy AI objects to look. It also includes the aim assist
      for weapons/powers and the option active to change between locked targets using
      camera movement (mouse/gamepad/touch joystick).
    sceneNumber: 22
    sceneImage: {fileID: 2800000, guid: a0ab100dd3916e14b9449a99286bf393, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 16
    titleFontSize: 0
  - Name: Locked Camera Transistions
    sceneDescription: A demo showing different locked camera and transitions between
      them, including top down, fixed camera, 2.5d, isometric, point & click, tank
      controls, etc...
    sceneNumber: 23
    sceneImage: {fileID: 2800000, guid: 18aec3acabf060843ba8b33186b02cc2, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 16
    titleFontSize: 0
  - Name: Mansion First Person
    sceneDescription: Mansion with only first person camera view (camera can't be
