    sceneNumber: 27
    sceneImage: {fileID: 2800000, guid: 2c7e411c5a016814ea72b4aa278be090, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Third Person Facing Camera Mansion
