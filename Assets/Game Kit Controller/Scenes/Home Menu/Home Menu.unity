    sceneNumber: 48
    sceneImage: {fileID: 2800000, guid: ce56a394dc8fc6c46b1ba4f6343e539c, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Turn Based Combat System
    sceneDescription: Scene to show the new turn based combat system, inspired in
