    sceneNumber: 28
    sceneImage: {fileID: 2800000, guid: 3d32e3164cc52c84db9ff56732601710, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Mansion Demo Remake 2
    sceneDescription: Mansion with free camera and dual weapons configured to use
