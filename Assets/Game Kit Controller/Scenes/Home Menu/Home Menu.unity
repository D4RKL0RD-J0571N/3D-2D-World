    sceneImage: {fileID: 2800000, guid: 3971d9ca70efa7440a6f87b1d90b2c21, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Tank Controls Mansion
    sceneDescription: Mansion with locked camera using regular locked camera and
