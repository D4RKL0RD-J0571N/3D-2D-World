    sceneDescription: An open scene with different stuff to try.
    sceneNumber: 45
    sceneImage: {fileID: 2800000, guid: f051956134c79c540846d01232e771d0, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Switch Character Companion
    sceneDescription: A little demo showing the switch of characters ingame, allowing
      the player to change character ingame at any moment, setting the other characters
      as AI.
    sceneNumber: 46
    sceneImage: {fileID: 2800000, guid: 6db22cf5bae04ba469e202c8547def1b, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
