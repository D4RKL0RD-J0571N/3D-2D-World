    sceneNumber: 43
    sceneImage: {fileID: 2800000, guid: bf2dd33df7cd5724d892ee24056bad58, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Slopes, Stair & Ground Adherence System
    sceneDescription: A demo to show the ground adherence system to walk on, slopes,
      stairs with real mesh colliders and different height step, including different
      step inclination and other irregular surfaces.
    sceneNumber: 44
    sceneImage: {fileID: 2800000, guid: 230585c50f8a7854d9010966b336e942, type: 3}
