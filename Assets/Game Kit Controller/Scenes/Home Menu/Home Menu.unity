    sceneNumber: 24
    sceneImage: {fileID: 2800000, guid: fb6f551392d001946a24a8c4e5fd1f71, type: 3}
    sceneButton: {fileID: 0}
    addSceneToList: 1
    fontSize: 20
    titleFontSize: 0
  - Name: Isometric Mansion
