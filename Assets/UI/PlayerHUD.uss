/* ═══════════════════════════════════════════════════════
   PLAYER HUD — Skyrim Fantasy Overhaul
   Design Language: Elder Scrolls Dark Glass + Gold Accents
   ═══════════════════════════════════════════════════════ */

/* ── Root ─────────────────────────────────────────────── */
.player-hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    pointer-events: none;
}

.hidden-tracker {
    display: none;
    width: 0; height: 0;
}

/* ── Fullscreen Damage Vignette ───────────────────────── */
.damage-vignette {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(232, 69, 60, 0);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.damage-vignette--active {
    background-color: rgba(232, 69, 60, 0.38);
}

/* ╔═════════════════════════════════════════════════════╗
   ║  SKYRIM TOP COMPASS BAR                             ║
   ╚═════════════════════════════════════════════════════╝ */
.compass-container {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    flex-direction: column;
}

.compass-strip {
    width: 440px;
    height: 28px;
    background-color: rgba(6, 8, 14, 0.88);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.35);
    border-top-width: 1.5px;
    border-top-color: rgba(240, 180, 41, 0.65);
    overflow: hidden;
    position: relative;
    justify-content: center;
    align-items: center;
}

/* Center diamond tick / notch pointing down */
.compass-notch {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 6px;
    height: 6px;
    background-color: rgba(240, 180, 41, 1);
    rotate: 45deg;
}

/* Tape mask for sliding cardinal directions */
.compass-tape-mask {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    justify-content: center;
    align-items: center;
}

.compass-tape {
    flex-direction: row;
    align-items: center;
    position: absolute;
    height: 100%;
    transition-property: left;
    transition-duration: 0.05s;
}

.compass-cardinal {
    font-size: 11px;
    color: rgba(180, 195, 215, 0.7);
    -unity-font-style: bold;
    margin: 0 14px;
    -unity-text-align: middle-center;
}

.compass-cardinal--primary {
    color: rgba(240, 180, 41, 0.95);
    font-size: 12px;
}

.compass-dot {
    font-size: 14px;
    color: rgba(100, 115, 140, 0.5);
    margin: 0 4px;
    -unity-text-align: middle-center;
}

/* Dynamic POI Markers Layer */
.compass-markers-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
}

.compass-marker-pip {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
    width: 16px;
    height: 16px;
    background-color: rgba(240, 180, 41, 0.9);
    border-radius: 3px;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: #000000;
    -unity-font-style: bold;
}

.compass-marker-pip--quest {
    background-color: rgba(56, 189, 248, 1);
    rotate: 45deg;
}

.compass-marker-pip--enemy {
    background-color: rgba(239, 68, 68, 1);
    border-radius: 50%;
    width: 10px;
    height: 10px;
}

.compass-marker-pip--dungeon {
    background-color: rgba(168, 85, 247, 1);
    border-radius: 2px;
}

.compass-marker-pip--camp {
    background-color: rgba(249, 115, 22, 1);
    border-radius: 3px;
}

.compass-marker-pip--shrine {
    background-color: rgba(251, 191, 36, 1);
    border-radius: 50%;
}

.compass-marker-pip--town {
    background-color: rgba(34, 197, 94, 1);
    border-radius: 2px;
}

/* Discovery Banner (Skyrim-style location reveal) */
.discovery-banner {
    margin-top: 10px;
    padding: 4px 18px;
    background-color: rgba(8, 10, 18, 0.92);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.45);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.discovery-banner--visible {
    opacity: 1;
}

.discovery-text {
    font-size: 13px;
    color: rgba(240, 180, 41, 1);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

/* ╔═════════════════════════════════════════════════════╗
   ║  STATUS BARS: HEALTH, MAGICKA, STAMINA              ║
   ╚═════════════════════════════════════════════════════╝ */
.status-panel {
    position: absolute;
    left: 18px;
    top: 18px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 10px;
    background-color: rgba(8, 10, 18, 0.90);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.25);
    border-top-width: 2px;
    border-top-color: rgba(240, 180, 41, 0.6);
}

.avatar-frame {
    width: 52px;
    height: 52px;
    margin-right: 12px;
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(240, 180, 41, 0.6);
    background-color: rgba(30, 35, 50, 0.95);
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: visible;
}

.avatar-image {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: rgba(40, 50, 70, 0.8);
}

.avatar-level-badge {
    position: absolute;
    bottom: -6px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(240, 180, 41, 0.95);
    color: rgba(10, 10, 20, 1);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 1px 5px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.bars-column {
    flex-direction: column;
    justify-content: center;
    min-width: 210px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.stat-icon {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    margin-right: 7px;
    flex-shrink: 0;
}

.stat-icon--hp {
    background-color: rgba(232, 69, 60, 0.9);
    border-width: 1px;
    border-color: rgba(255, 100, 90, 0.5);
}

.stat-icon--mp {
    background-color: rgba(56, 189, 248, 0.9);
    border-width: 1px;
    border-color: rgba(125, 211, 252, 0.5);
}

.stat-icon--sp {
    background-color: rgba(34, 197, 94, 0.9);
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.5);
}

.stat-track {
    flex-grow: 1;
    height: 11px;
    background-color: rgba(16, 20, 32, 0.95);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    position: relative;
}

.stat-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.15s;
}

.stat-fill--hp { background-color: rgb(200, 40, 35); }
.stat-fill--mp { background-color: rgb(30, 130, 225); }
.stat-fill--sp { background-color: rgb(22, 163, 74); }

.stat-fill-shine {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 5px 5px 0 0;
}

.stat-value {
    width: 58px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgba(220, 230, 245, 0.85);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
    margin-left: 7px;
    flex-shrink: 0;
}

.status-bar--exhausted {
    border-width: 1px;
    border-color: rgba(232, 69, 60, 0.9);
    background-color: rgba(50, 10, 10, 0.3);
}

/* ╔═════════════════════════════════════════════════════╗
   ║  RETICLE & SKYRIM SNEAK EYE                         ║
   ╚═════════════════════════════════════════════════════╝ */
.reticle-container {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.reticle-ring {
    width: 30px;
    height: 30px;
    justify-content: center;
    align-items: center;
    position: relative;
}

.reticle-dot {
    width: 4px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 2px;
}

.reticle-arm {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 1px;
}

.reticle-arm--top    { width: 2px; height: 8px; top: 0;    left: 50%; translate: -50% 0; }
.reticle-arm--bottom { width: 2px; height: 8px; bottom: 0; left: 50%; translate: -50% 0; }
.reticle-arm--left   { height: 2px; width: 8px; left: 0;   top: 50%;  translate: 0 -50%; }
.reticle-arm--right  { height: 2px; width: 8px; right: 0;  top: 50%;  translate: 0 -50%; }

/* Skyrim Sneak Eye Container */
.sneak-eye-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: absolute;
    display: none; /* Only flex when crouching */
}

.sneak-eye-bracket-left {
    width: 14px;
    height: 20px;
    border-left-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(240, 245, 255, 0.9);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    margin-right: 4px;
    transition-property: width, height;
    transition-duration: 0.15s;
}

.sneak-eye-bracket-right {
    width: 14px;
    height: 20px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(240, 245, 255, 0.9);
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    margin-left: 4px;
    transition-property: width, height;
    transition-duration: 0.15s;
}

.sneak-eye-pupil {
    width: 6px;
    height: 6px;
    background-color: rgba(240, 245, 255, 0.95);
    border-radius: 3px;
    transition-property: width, height;
    transition-duration: 0.12s;
}

.sneak-eye-label {
    position: absolute;
    bottom: -18px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(240, 245, 255, 0.85);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* ╔═════════════════════════════════════════════════════╗
   ║  CONTEXTUAL PROMPT & KEY HINTS                      ║
   ╚═════════════════════════════════════════════════════╝ */
.prompt-container {
    position: absolute;
    width: 100%;
    top: 58%;
    align-items: center;
    justify-content: center;
}

.prompt-badge {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px 6px 8px;
    background-color: rgba(8, 10, 18, 0.90);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.55);
}

.prompt-key-bubble {
    width: 24px;
    height: 24px;
    background-color: rgba(240, 180, 41, 0.2);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.7);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
}

.prompt-key-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(240, 180, 41, 1);
    -unity-text-align: middle-center;
}

.prompt-label {
    color: rgba(240, 245, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.key-hints-container {
    position: absolute;
    bottom: 120px;
    right: 18px;
    flex-direction: column;
    align-items: flex-end;
}

.key-hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.key-pill {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(200, 210, 230, 0.85);
    background-color: rgba(40, 50, 70, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    padding: 1px 5px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.key-hint-text {
    font-size: 10px;
    color: rgba(148, 163, 184, 0.75);
}
