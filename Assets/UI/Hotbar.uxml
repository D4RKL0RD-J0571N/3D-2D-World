<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="HotbarRoot" class="hotbar-root" picking-mode="Ignore">

        <!-- Selected Item Label -->
        <ui:VisualElement class="active-item-pip" picking-mode="Ignore">
            <ui:Label name="ActiveBlockLabel" text="" class="active-item-name" />
        </ui:VisualElement>

        <!-- 9-Slot Hotbar Strip -->
        <ui:VisualElement class="hotbar-strip">
            <ui:VisualElement name="Slot_0" class="hb-slot hb-slot--selected">
                <ui:Label text="1" class="hb-number" />
                <ui:VisualElement name="Icon_0" class="hb-icon" />
                <ui:VisualElement class="hb-selected-glow" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_1" class="hb-slot">
                <ui:Label text="2" class="hb-number" />
                <ui:VisualElement name="Icon_1" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_2" class="hb-slot">
                <ui:Label text="3" class="hb-number" />
                <ui:VisualElement name="Icon_2" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_3" class="hb-slot">
                <ui:Label text="4" class="hb-number" />
                <ui:VisualElement name="Icon_3" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_4" class="hb-slot hb-slot--divider">
                <ui:Label text="5" class="hb-number" />
                <ui:VisualElement name="Icon_4" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_5" class="hb-slot">
                <ui:Label text="6" class="hb-number" />
                <ui:VisualElement name="Icon_5" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_6" class="hb-slot">
                <ui:Label text="7" class="hb-number" />
                <ui:VisualElement name="Icon_6" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_7" class="hb-slot">
                <ui:Label text="8" class="hb-number" />
                <ui:VisualElement name="Icon_7" class="hb-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="Slot_8" class="hb-slot">
                <ui:Label text="9" class="hb-number" />
                <ui:VisualElement name="Icon_8" class="hb-icon" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
