/* ═══════════════════════════════════════════════════════
   CURATOR OVERLAY — Designer Overhaul
   Design: Right-side inspection card, blue-cyan theme
   ═══════════════════════════════════════════════════════ */

/* ── Root Panel ─────────────────────────────────────────── */
.curator-root {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    width: 360px;
    max-height: 80%;
    background-color: rgba(8, 12, 22, 0.96);
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.30);
    border-radius: 14px;
    overflow: hidden;
    flex-direction: column;
}

/* ── Header ─────────────────────────────────────────────── */
.curator-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    background-color: rgba(14, 22, 42, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 189, 248, 0.20);
}

.curator-header-icon {
    width: 20px;
    height: 20px;
    background-color: rgba(56, 189, 248, 0.25);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.6);
    margin-right: 10px;
    flex-shrink: 0;
}

.curator-title {
    flex-grow: 1;
    font-size: 12px;
    color: rgba(56, 189, 248, 1);
    -unity-font-style: bold;
    letter-spacing: 2.5px;
}

.curator-close-btn {
    width: 28px;
    height: 28px;
    background-color: rgba(80, 20, 20, 0.5);
    border-color: rgba(200, 60, 60, 0.35);
    border-radius: 6px;
    border-width: 1px;
    color: rgba(255, 140, 140, 1);
    font-size: 13px;
    padding: 0;
    -unity-text-align: middle-center;
}

.curator-close-btn:hover {
    background-color: rgba(180, 40, 40, 0.9);
    border-color: rgba(255, 80, 80, 0.7);
}

/* ── Scrollable Body ────────────────────────────────────── */
.curator-body-scroll {
    flex-grow: 1;
}

.curator-body {
    padding: 14px 16px;
    flex-direction: column;
}

/* ── Meta Row ───────────────────────────────────────────── */
.meta-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.meta-spacer { flex-grow: 1; }

/* Badge base */
.badge {
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 5px;
    padding: 2px 9px;
    margin-right: 6px;
}

.badge--category {
    background-color: rgba(30, 60, 120, 0.65);
    color: rgba(147, 210, 255, 1);
    border-width: 1px;
    border-color: rgba(56, 150, 240, 0.35);
}

.badge--id {
    background-color: rgba(30, 35, 55, 0.65);
    color: rgba(148, 163, 184, 1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.badge--status {
    background-color: rgba(50, 45, 10, 0.65);
    color: rgba(240, 180, 41, 0.9);
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.3);
    margin-right: 0;
}

/* ── Exhibit Info ────────────────────────────────────────── */
.curator-exhibit-name {
    font-size: 18px;
    color: rgba(240, 245, 255, 1);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.curator-origin {
    font-size: 11px;
    color: rgba(100, 130, 170, 1);
    margin-bottom: 10px;
}

/* ── Divider ─────────────────────────────────────────────── */
.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.07);
    margin: 10px 0;
}

/* ── Section Label ───────────────────────────────────────── */
.section-label {
    font-size: 10px;
    color: rgba(100, 160, 210, 1);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

/* ── Description Block ───────────────────────────────────── */
.curator-description {
    font-size: 12px;
    color: rgba(195, 210, 228, 0.90);
    white-space: normal;
    background-color: rgba(14, 22, 38, 0.65);
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 4px;
    border-left-width: 3px;
    border-left-color: rgba(56, 189, 248, 0.5);
}

/* ── Verdict Buttons ─────────────────────────────────────── */
.rating-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.verdict-btn {
    flex: 1;
    height: 40px;
    border-radius: 7px;
    border-width: 1px;
    margin: 0 3px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.verdict-icon {
    font-size: 14px;
    margin-right: 5px;
    -unity-text-align: middle-center;
}

.verdict-text {
    font-size: 11px;
    -unity-font-style: bold;
}

.verdict-btn--keep {
    background-color: rgba(20, 80, 40, 0.65);
    border-color: rgba(34, 197, 94, 0.40);
    color: rgba(134, 239, 172, 1);
}

.verdict-btn--keep:hover,
.verdict-btn--keep.active {
    background-color: rgba(21, 128, 61, 0.90);
    border-color: rgba(74, 222, 128, 0.85);
}

.verdict-btn--refine {
    background-color: rgba(90, 65, 10, 0.65);
    border-color: rgba(240, 180, 41, 0.40);
    color: rgba(252, 211, 77, 1);
}

.verdict-btn--refine:hover,
.verdict-btn--refine.active {
    background-color: rgba(161, 98, 7, 0.90);
    border-color: rgba(250, 204, 21, 0.85);
}

.verdict-btn--discard {
    background-color: rgba(90, 20, 20, 0.65);
    border-color: rgba(239, 68, 68, 0.40);
    color: rgba(252, 165, 165, 1);
}

.verdict-btn--discard:hover,
.verdict-btn--discard.active {
    background-color: rgba(185, 28, 28, 0.90);
    border-color: rgba(248, 113, 113, 0.85);
}

/* ── Notes Field ─────────────────────────────────────────── */
.notes-field {
    min-height: 72px;
    background-color: rgba(10, 14, 24, 0.85);
    border-color: rgba(56, 100, 160, 0.35);
    border-radius: 6px;
    color: rgba(210, 225, 245, 1);
    font-size: 12px;
    padding: 8px;
    border-width: 1px;
}

.notes-field:focus {
    border-color: rgba(56, 189, 248, 0.6);
}

/* ── Footer ──────────────────────────────────────────────── */
.curator-footer {
    padding: 10px 14px;
    background-color: rgba(10, 16, 30, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(56, 189, 248, 0.15);
}

.footer-btn {
    height: 34px;
    border-radius: 7px;
    border-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
}

.footer-btn--primary {
    background-color: rgba(30, 70, 130, 0.85);
    border-color: rgba(56, 150, 240, 0.55);
    color: rgba(220, 240, 255, 1);
}

.footer-btn--primary:hover {
    background-color: rgba(37, 99, 175, 0.95);
    border-color: rgba(96, 165, 250, 0.8);
}

.footer-btn-icon {
    font-size: 14px;
    margin-right: 6px;
}

.footer-btn-text {
    font-size: 12px;
    -unity-font-style: bold;
}

/* rating-status — kept for C# back-compat */
.rating-status {
    font-size: 11px;
    color: rgba(148, 163, 184, 1);
    margin-bottom: 10px;
}

/* Old aliases for C# binding compat */
.curator-action-button { }
.curator-close-button { }
.rating-btn { }
.rating-btn-keep { }
.rating-btn-refine { }
.rating-btn-discard { }
.rating-button-row { }
