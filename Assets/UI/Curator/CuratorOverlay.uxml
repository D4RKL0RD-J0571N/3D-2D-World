<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="CuratorRoot" class="curator-root">

        <!-- Header Bar -->
        <ui:VisualElement name="CuratorHeader" class="curator-header">
            <ui:VisualElement class="curator-header-icon" />
            <ui:Label name="CuratorTitle" text="CURATOR EVALUATION" class="curator-title" />
            <ui:Button name="CuratorClose" text="✕" class="curator-close-btn" />
        </ui:VisualElement>

        <!-- Scrollable Body -->
        <ui:ScrollView class="curator-body-scroll">
            <ui:VisualElement name="CuratorBody" class="curator-body">

                <!-- Meta Row: Category + ID badges -->
                <ui:VisualElement class="meta-row">
                    <ui:Label name="ExhibitCategory" text="WEAPON" class="badge badge--category" />
                    <ui:Label name="ExhibitId" text="EXH_0001" class="badge badge--id" />
                    <ui:VisualElement class="meta-spacer" />
                    <ui:Label name="RatingStatusLabel" text="UNRATED" class="badge badge--status" />
                </ui:VisualElement>

                <!-- Exhibit Name -->
                <ui:Label name="ExhibitName" text="Exhibit Display Name" class="curator-exhibit-name" />
                <ui:Label name="ExhibitOrigin" text="Source: RetroWeaponPack_V1" class="curator-origin" />

                <!-- Divider -->
                <ui:VisualElement class="divider" />

                <!-- Description -->
                <ui:Label text="DESCRIPTION" class="section-label" />
                <ui:Label name="ExhibitDescription" text="Detailed notes regarding this asset or mechanic testing." class="curator-description" />

                <!-- Divider -->
                <ui:VisualElement class="divider" />

                <!-- Verdict Buttons -->
                <ui:Label text="VERDICT" class="section-label" />
                <ui:VisualElement class="rating-row">
                    <ui:Button name="BtnKeep" class="verdict-btn verdict-btn--keep">
                        <ui:Label text="✔" class="verdict-icon" />
                        <ui:Label text="KEEP" class="verdict-text" />
                    </ui:Button>
                    <ui:Button name="BtnRefine" class="verdict-btn verdict-btn--refine">
                        <ui:Label text="⚙" class="verdict-icon" />
                        <ui:Label text="REFINE" class="verdict-text" />
                    </ui:Button>
                    <ui:Button name="BtnDiscard" class="verdict-btn verdict-btn--discard">
                        <ui:Label text="✕" class="verdict-icon" />
                        <ui:Label text="DISCARD" class="verdict-text" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Divider -->
                <ui:VisualElement class="divider" />

                <!-- Notes Field -->
                <ui:Label text="CURATOR NOTES" class="section-label" />
                <ui:TextField name="CuratorNotesField" multiline="true" class="notes-field"
                              placeholder-text="Add evaluation notes here..." />

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Footer Actions -->
        <ui:VisualElement name="CuratorFooter" class="curator-footer">
            <ui:Button name="BtnExportReport" class="footer-btn footer-btn--primary">
                <ui:Label text="💾" class="footer-btn-icon" />
                <ui:Label text="Save &amp; Export" class="footer-btn-text" />
            </ui:Button>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
