<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="LabRoot" class="lab-root">
        <ui:VisualElement name="LabHeader" class="lab-header">
            <ui:Label name="LabTitle" text="LAB" class="lab-title" />
            <ui:Button name="LabResetAll" text="Reset All" class="lab-button" />
            <ui:Button name="LabClose" text="×" class="lab-close-button" />
        </ui:VisualElement>
        <ui:ScrollView name="LabScrollView" class="lab-scroll">
            <ui:VisualElement name="LabGroupsContainer" class="lab-groups-container" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
