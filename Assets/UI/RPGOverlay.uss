/* ═══════════════════════════════════════════════════════════════
   RPGOverlay.uss  —  Skill toasts, quest tracker, level badge
   Palette: gold (#C9A84C), dark glass (#1A1A1A CC), crimson accent
   ═══════════════════════════════════════════════════════════════ */

/* ── Root ─────────────────────────────────────────────────────── */
.rpg-overlay-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

/* ── Character Level Badge ────────────────────────────────────── */
.char-level-badge {
    position: absolute;
    top: 12px;
    right: 14px;
    background-color: rgba(26, 26, 26, 0.85);
    border-color: rgba(201, 168, 76, 0.7);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 10px;
}

.char-level-label {
    color: rgba(201, 168, 76, 1);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Skill Level-Up Toast ─────────────────────────────────────── */
.skill-toast-container {
    position: absolute;
    bottom: 120px;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.skill-toast-container.skill-toast--visible {
    opacity: 1;
}

.skill-toast-label {
    background-color: rgba(26, 26, 26, 0.9);
    border-color: rgba(201, 168, 76, 0.8);
    border-width: 1px;
    border-radius: 3px;
    color: rgba(201, 168, 76, 1);
    font-size: 15px;
    -unity-font-style: bold;
    padding: 6px 20px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* ── Quest Tracker Panel ──────────────────────────────────────── */
.quest-tracker {
    position: absolute;
    top: 44px;
    right: 14px;
    width: 220px;
    background-color: rgba(16, 16, 24, 0.82);
    border-color: rgba(201, 168, 76, 0.45);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 10px;
}

.quest-tracker-header {
    border-bottom-color: rgba(201, 168, 76, 0.3);
    border-bottom-width: 1px;
    margin-bottom: 6px;
    padding-bottom: 4px;
}

.quest-tracker-heading {
    color: rgba(201, 168, 76, 0.7);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.quest-title-label {
    color: rgba(220, 200, 150, 1);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.quest-objective-label {
    color: rgba(200, 200, 200, 0.9);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 2px;
}

.quest-progress-label {
    color: rgba(150, 200, 150, 0.9);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
