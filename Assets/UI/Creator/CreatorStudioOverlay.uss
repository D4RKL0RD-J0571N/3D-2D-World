.creator-studio-root {
    position: absolute;
    bottom: 12px;
    left: 20px;
    right: 20px;
    background-color: rgba(15, 18, 25, 0.94);
    border-width: 1.5px;
    border-color: rgba(99, 102, 241, 0.6);
    border-radius: 12px;
    padding: 12px 16px;
    flex-direction: column;
}

.creator-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    padding-bottom: 8px;
    margin-bottom: 8px;
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.header-right {
    flex-direction: row;
    align-items: center;
}

.creator-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #e0e7ff;
    margin-right: 14px;
}

.mode-toggle-btn {
    background-color: rgba(79, 70, 229, 0.85);
    color: #ffffff;
    border-radius: 6px;
    padding: 5px 12px;
    border-width: 1px;
    border-color: #818cf8;
    -unity-font-style: bold;
    font-size: 12px;
}

.mode-toggle-btn:hover {
    background-color: rgba(99, 102, 241, 1);
}

.action-btn {
    background-color: rgba(40, 48, 66, 0.85);
    color: #cbd5e1;
    border-radius: 6px;
    padding: 5px 10px;
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    font-size: 11px;
}

.action-btn:hover {
    background-color: rgba(55, 65, 81, 1);
    color: #ffffff;
}

.action-btn-danger:hover {
    background-color: rgba(220, 38, 38, 0.8);
    border-color: #f87171;
    color: #ffffff;
}

.creator-filter-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.search-field {
    width: 220px;
    height: 28px;
    background-color: rgba(24, 28, 40, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #f1f5f9;
    padding-left: 6px;
}

.category-tabs {
    flex-direction: row;
    align-items: center;
}

.category-tab {
    background-color: rgba(30, 41, 59, 0.7);
    color: #94a3b8;
    border-radius: 6px;
    padding: 4px 10px;
    margin-left: 4px;
    border-width: 1px;
    border-color: transparent;
    font-size: 11px;
}

.category-tab:hover {
    color: #f8fafc;
    background-color: rgba(51, 65, 85, 0.8);
}

.category-tab-active {
    background-color: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
    border-color: #6366f1;
    -unity-font-style: bold;
}

.palette-scroll-view {
    height: 90px;
    margin-bottom: 6px;
}

.palette-grid {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.palette-card {
    width: 110px;
    height: 75px;
    background-color: rgba(26, 32, 48, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    margin-right: 8px;
    padding: 6px;
    align-items: center;
    justify-content: center;
}

.palette-card:hover {
    background-color: rgba(39, 48, 72, 1);
    border-color: #818cf8;
}

.palette-card-active {
    background-color: rgba(49, 46, 129, 0.8);
    border-color: #6366f1;
    border-width: 1.5px;
}

.palette-card-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #e2e8f0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.palette-card-category {
    font-size: 9px;
    color: #94a3b8;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.creator-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 6px;
}

.active-item-label {
    font-size: 11px;
    color: #38bdf8;
    -unity-font-style: bold;
}

.controls-hint-label {
    font-size: 10px;
    color: #94a3b8;
}
