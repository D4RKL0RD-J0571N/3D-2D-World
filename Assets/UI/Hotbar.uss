/* ═══════════════════════════════════════════════════════
   HOTBAR HUD — Designer Overhaul
   Design: Floating dark strip at bottom-center
   ═══════════════════════════════════════════════════════ */

.hotbar-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 20px;
    pointer-events: none;
}

/* Active item name pip above the hotbar */
.active-item-pip {
    align-items: center;
    margin-bottom: 6px;
}

.active-item-name {
    color: rgba(240, 180, 41, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgba(8, 10, 18, 0.80);
    border-radius: 10px;
    padding: 3px 12px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.3);
    text-shadow: 0 1px 3px rgba(0,0,0,0.9);
    -unity-text-align: middle-center;
}

/* Hotbar strip */
.hotbar-strip {
    flex-direction: row;
    padding: 6px 8px;
    background-color: rgba(8, 10, 18, 0.90);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(240, 180, 41, 0.20);
    pointer-events: auto;
}

/* Divider gap at slot 5 */
.hb-slot--divider {
    margin-left: 10px;
}

/* Individual slot */
.hb-slot {
    width: 54px;
    height: 54px;
    margin: 2px;
    background-color: rgba(20, 24, 38, 0.95);
    border-radius: 8px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.10);
    position: relative;
    justify-content: center;
    align-items: center;
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
}

.hb-slot:hover {
    border-color: rgba(240, 180, 41, 0.4);
    background-color: rgba(35, 40, 60, 0.95);
}

/* Selected slot */
.hb-slot--selected {
    border-color: rgba(240, 180, 41, 0.85);
    background-color: rgba(50, 42, 20, 0.95);
    border-width: 2px;
}

/* Gold glow beneath selected slot */
.hb-selected-glow {
    position: absolute;
    bottom: -6px;
    left: 50%;
    translate: -50% 0;
    width: 28px;
    height: 4px;
    background-color: rgba(240, 180, 41, 0.7);
    border-radius: 2px;
}

/* Icon */
.hb-icon {
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Slot number */
.hb-number {
    position: absolute;
    left: 5px;
    top: 3px;
    font-size: 10px;
    color: rgba(180, 190, 210, 0.7);
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.8);
}

/* Aliases the old class names the HotbarHUD.cs script uses */
.hotbar-root { }
.hotbar-slot { }
.hotbar-slot--selected { }
.hotbar-slot__icon { }
.hotbar-slot__number { }
.hotbar-label { }
.hotbar-container { }
